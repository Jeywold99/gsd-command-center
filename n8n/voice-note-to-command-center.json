{
  "nodes": [
    {
      "parameters": {
        "method": "POST",
        "url": "https://gsd.getshtdonehq.com/api/voice-notes/ingest",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-voice-key", "value": "={{ $('Webhook').first().json.body.voice_key || '' }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({}, $json, { source: $json.source || 'shortcut', received_at: $json.received_at || $now.toISO(), external_id: String($execution.id) })) }}",
        "options": { "timeout": 20000 }
      },
      "id": "c2b2f001-0000-4000-8000-000000000001",
      "name": "Log to Command Center",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 700],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {}
}

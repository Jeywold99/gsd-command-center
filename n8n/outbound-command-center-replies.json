{
  "name": "GSD — Command Center Replies → Gmail",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 1 }] }
      },
      "id": "c2b2f002-0000-4000-8000-000000000001",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.GSD_BASE_URL }}/api/emails/outbox",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.GSD_API_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "c2b2f002-0000-4000-8000-000000000002",
      "name": "GET /api/emails/outbox",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "messages",
        "options": {}
      },
      "id": "c2b2f002-0000-4000-8000-000000000003",
      "name": "Each queued reply",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "reply",
        "messageId": "={{ $json.replyToMessageId }}",
        "emailType": "text",
        "message": "={{ $json.bodyText }}",
        "options": {}
      },
      "id": "c2b2f002-0000-4000-8000-000000000004",
      "name": "Gmail: send reply",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [900, 300],
      "credentials": {
        "gmailOAuth2": { "id": "REPLACE_WITH_GMAIL_CREDENTIAL", "name": "Jana Gmail" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GSD_BASE_URL }}/api/emails/{{ $('Each queued reply').item.json.id }}/sent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.GSD_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ externalId: $json.id }) }}",
        "options": {}
      },
      "id": "c2b2f002-0000-4000-8000-000000000005",
      "name": "POST .../sent (confirm)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Every minute": {
      "main": [[{ "node": "GET /api/emails/outbox", "type": "main", "index": 0 }]]
    },
    "GET /api/emails/outbox": {
      "main": [[{ "node": "Each queued reply", "type": "main", "index": 0 }]]
    },
    "Each queued reply": {
      "main": [[{ "node": "Gmail: send reply", "type": "main", "index": 0 }]]
    },
    "Gmail: send reply": {
      "main": [[{ "node": "POST .../sent (confirm)", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}

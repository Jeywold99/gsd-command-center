# GSD Command Center — production environment.
# Copy to `.env` on the Pi and fill in real values:  cp .env.production.example .env
# NEVER commit the filled-in .env.

# ── PostgreSQL (containerized by docker-compose) ──
POSTGRES_USER=gsd
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=command_center

# App → DB. Host is the compose service name `db`. The password MUST match
# POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://gsd:CHANGE_ME_strong_db_password@db:5432/command_center?schema=public

# ── Auth ──
# Generate a fresh secret:  openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_32_byte_base64_secret
# First Owner account, seeded once via `docker compose exec web npm run seed`.
# Change the password after first login.
OWNER_EMAIL=owner@yourdomain.com
OWNER_PASSWORD=CHANGE_ME_owner_password
OWNER_NAME=Jana

# ── Public URL (your Cloudflare Tunnel hostname) ──
# One origin serves everything; /socket.io is routed to the socket service by
# the tunnel, so these three are all the SAME hostname.
CLIENT_ORIGIN=https://gsd.yourdomain.com
NEXT_PUBLIC_SOCKET_URL=https://gsd.yourdomain.com
GSD_ALLOWED_ORIGIN=gsd.yourdomain.com

# ── Shared Inbox ──
# The address replies are sent AS (n8n's connected Gmail).
GSD_INBOX_ADDRESS=jana@yourdomain.com

# ── Cloudflare Tunnel ──
# Zero Trust → Networks → Tunnels → (your tunnel) → "Install connector" → copy
# the token from the `--token` value.
TUNNEL_TOKEN=CHANGE_ME_cloudflared_tunnel_token

# ── CI build + pull path only (docker-compose.prod.yml) ──
# The prebuilt image pushed by the GitHub Actions workflow. Must be lowercase.
IMAGE=ghcr.io/youruser/yourrepo:latest
